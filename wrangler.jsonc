{
  "name": "fastfood-ai-assistant",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "DEMO_ENABLED": "false",
    "WHATSAPP_API_VERSION": "v23.0"
  }
}
